# Copy to .env and fill in with YOUR OWN project's values.
# Only public, browser-safe values belong in this file.
# Private keys (mail provider, A.I. providers, service credentials) are added
# in Project Settings > Secrets, never here.

# Backend project reference (public identifier)
SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Backend API URL (public)
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable / anon key (public by design, protected by row-level security)
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
